# Copia este archivo como ".env.local" y completa tus llaves reales.
# .env.local nunca se debe subir a git (ya está en .gitignore).
# Todas las integraciones son opcionales: sin llave, el sitio funciona en modo degradado.

# --- Supabase (catálogo, pedidos y datos reales) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Pasarela de pagos (Wompi) ---
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=

# --- Asistente de compra con IA (Groq, nivel gratuito) ---
GROQ_API_KEY=

# --- Notificaciones por correo (Resend, opcional) ---
RESEND_API_KEY=

# --- URL base del sitio (sitemap y SEO) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
